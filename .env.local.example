# Local Ollama (keep production's existing model and ports if different).
OLLAMA_HOST=http://127.0.0.1
OLLAMA_MODEL=gemma2:2b
OLLAMA_PORTS=11435

# Existing Supabase sign-in/history. Blank values leave public play available.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://askgobi.net

# Optional aggregate-only telemetry; server secret, NEVER NEXT_PUBLIC_.
# Apply supabase/curiosity_events.sql before enabling.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Enable ONLY if the origin is inaccessible except through Cloudflare Tunnel.
# Otherwise every client intentionally shares a conservative rate-limit bucket.
TRUST_CLOUDFLARE_PROXY=false

# Optional Connect the Signal services. Keep disabled until staging/host checks pass.
# Apply supabase/signal.sql and supabase/curiosity_signal_events.sql first.
SIGNAL_LEADERBOARD_ENABLED=false
SIGNAL_COACH_ENABLED=false
# At least 32 random characters; server-only. Preserve it across host restarts.
SIGNAL_TICKET_SECRET=

# Optional local preview directory to avoid conflicts with production builds.
# NEXT_BUILD_DIR=.next-dev
